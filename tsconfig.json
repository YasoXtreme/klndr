{
  // The TypeScript that exists so far: the test suites, the page build and the
  // tool configs. The app and the server join as they are converted.
  "extends": "./tsconfig.base.json",
  "include": [
    "test/**/*.ts",
    "e2e/**/*.ts",
    "apps/web/*.mts",
    "apps/web/build/**/*.mts",
    "playwright.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", ".claude", "motion"]
}
