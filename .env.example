# Copy to .env and fill in. Nothing here has a default: a silently-defaulted
# secret is worse than a crash, because everything appears to work.

# --- Database --------------------------------------------------------------
MONGODB_URI=
# Isolate environments, e.g. klndr_dev locally and klndr in production.
MONGODB_DB=klndr

# --- Server ----------------------------------------------------------------
PORT=3001
SESSION_SECRET=

# Timezone the admin analytics page reports in - an IANA name, e.g.
# Europe/Sofia. Activity is STORED in UTC and converted on read, so changing
# this re-labels history rather than rewriting it. Defaults to UTC.
ANALYTICS_TZ=

# --- Integrations ----------------------------------------------------------
# Absolute, public origin of THIS deployment. Used to build the OAuth redirect
# URI, which has to match the one registered with the provider byte for byte,
# so it cannot be derived from the request: behind a proxy the Host header is
# not reliably the public name.
KLNDR_BASE_URL=http://localhost:3001

# Encrypts integration tokens at rest (AES-256-GCM). klndr's own session
# tokens are stored in the clear, which is fine because they only unlock
# klndr. An integration's refresh token unlocks a different system, which is
# why this one is encrypted. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENC_KEY=

# --- Sylla integration -----------------------------------------------------
# Register an app at <sylla>/developers, set its redirect URI to
#   <KLNDR_BASE_URL>/api/integrations/sylla/callback
# and tick the scopes profile.read, sessions.read, progress.read and
# progress.write. The client secret is shown once.
SYLLA_BASE_URL=http://localhost:3000
SYLLA_CLIENT_ID=
SYLLA_CLIENT_SECRET=

# --- Media storage: Cloudflare R2 --------------------------------------------
# Announcement headers - images, GIFs, SVG, video, Lottie - live in an R2
# bucket. Leave these empty and uploads are simply off; motion scenes still work.
#
# In the Cloudflare dashboard: R2 > Create bucket, then R2 > Manage API tokens >
# Create API token with "Object Read & Write" on that bucket. The account ID is
# on the R2 overview page. Then run  npm run r2:cors  and  npm run r2:check.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: the bucket's public address - a custom domain connected to it, or
# its r2.dev URL (fine for testing, rate-limited). Without it the bucket stays
# private and klndr signs every read itself, so only signed-in people can load
# the media.
R2_PUBLIC_BASE_URL=
