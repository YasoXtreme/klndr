# Copy to .env.test for `npm run test:integration` and `npm run test:e2e`.
#
# The suites create and delete accounts, tasks and posts, so they refuse any
# database whose name doesn't end in _e2e or _test. Anything not set here
# (usually MONGODB_URI) comes from .env, and the shell wins over both.
MONGODB_DB=klndr_e2e
