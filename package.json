{
  "name": "klndr",
  "version": "1.0.0",
  "description": "Klndr: A Fluid Time-Blocking Workspace",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run check:tokens && npm test",
    "check:tokens": "node scripts/check-design-tokens.js",
    "dev": "node --watch server.js",
    "r2:check": "node scripts/r2.js check",
    "r2:cors": "node scripts/r2.js cors",
    "vendor": "node scripts/vendor-browser-libs.js",
    "add-user": "node scripts/manage-users.js add",
    "list-users": "node scripts/manage-users.js list",
    "delete-user": "node scripts/manage-users.js delete",
    "reset-password": "node scripts/manage-users.js reset"
  },
  "keywords": [
    "calendar",
    "time-blocking",
    "productivity",
    "canvas",
    "fluid-ui"
  ],
  "author": "Yassen",
  "license": "ISC",
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "lottie-web": "^5.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
