{
  "name": "klndr",
  "version": "1.0.0",
  "private": true,
  "description": "Klndr: A Fluid Time-Blocking Workspace",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/server/src/server.js",
    "dev": "node scripts/dev.mjs",
    "build:web": "node apps/web/build.mts",
    "build": "node scripts/build-vercel-output.mjs",
    "serve:bundle": "node scripts/serve-bundle.mjs",
    "test:build": "vitest run --project build",
    "test": "vitest run --project unit",
    "pretest:integration": "npm run build:web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run check:tokens && npm test",
    "check:tokens": "node scripts/check-design-tokens.js",
    "r2:check": "node scripts/r2.js check",
    "r2:cors": "node scripts/r2.js cors",
    "add-user": "node scripts/manage-users.js add",
    "list-users": "node scripts/manage-users.js list",
    "delete-user": "node scripts/manage-users.js delete",
    "reset-password": "node scripts/manage-users.js reset"
  },
  "keywords": [
    "calendar",
    "time-blocking",
    "productivity",
    "canvas",
    "fluid-ui"
  ],
  "author": "Yassen",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
